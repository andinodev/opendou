# Godot 4.x specific ignores
.godot/
*.translation
# Los .import NO se ignoran: llevan el UID y los ajustes de importacion del
# recurso, y sin versionarlos cada clon regenera UIDs distintos.

# Godot export/build output
export/
build/
bin/

# GDExtension / C++ build artifacts
*.o
*.obj
*.so
*.dylib
*.dll
*.lib
*.exp
*.pdb
*.ilk
.sconsign.dblite
.scons_temp/
scons-local/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Rust / Cargo build artifacts (if using gdext)
/target/
**/*.rs.bk
Cargo.lock

# C# / .NET build artifacts
.vs/
obj/
*.csproj.user
*.suo
*.user

# Editor & OS files
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp files
*.log
*.tmp
*.bak

# Dependencias nativas de la Fase 7: cientos de megas de binarios de terceros. Se rellenan
# a mano segun native/thirdparty/README.md. El volcado de la API de Godot SI se versiona.
native/thirdparty/*
!native/thirdparty/README.md
native/build/
# El volcado de la API de Godot se REGENERA con native/dump_godot_api.sh: son 7 MB que
# godot-cpp master ya trae como extension_api-4-7.json. Sirve para verificar, no para
# versionar.
native/godot-api/
