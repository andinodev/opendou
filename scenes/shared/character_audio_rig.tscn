[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scenes/shared/character_audio_rig.gd" id="1_rig"]
[ext_resource type="Script" path="res://addons/opendou/nodes/opendou_event_player_3d.gd" id="2_emitter"]
[ext_resource type="Script" path="res://addons/opendou/nodes/opendou_animation_sync.gd" id="3_sync"]

[node name="CharacterAudioRig" type="Node3D"]
script = ExtResource("1_rig")

[node name="RigEmitter" type="AudioStreamPlayer3D" parent="."]
unit_size = 6.0
area_mask = 1
script = ExtResource("2_emitter")
event_name = &"Footstep"
enable_dynamic_occlusion = true

[node name="FootstepSync" type="Node" parent="."]
script = ExtResource("3_sync")
target_emitter_path = NodePath("../RigEmitter")
auto_detect_surface = true
default_footstep_event = &"Footstep"
