[node name="Hud" parent="." instance=ExtResource("11_hud")]
demo_title = "Bajo la quilla"
thesis = "El MISMO emisor sin tocar suena de cuatro maneras distintas solo por geometria: directo por la escotilla, difractado al cerrarla, como cola de reverb desde el pasillo, y opaco desde la bahia inundada."
controls = Array[String](["Flechas — caminar", "Raton — mirar", "E — abrir y cerrar la escotilla", "F9 — depurador acustico", "F1 — mostrar u ocultar este cartel"])
exercises = Array[String](["OpenDouRoom3D — tres recintos con perfiles acusticos distintos", "OpenDouPortal3D — la escotilla, con difraccion segun su apertura", "OpenDouReflector3D — reflexiones en los dos mamparos", "OpenDouParameterArea3D — RTPC WaterDepth en la bahia", "OpenDouAcousticGeometryBake — geometria acustica de los mamparos", "OpenDouAcousticDebugger3D — visualizacion del campo sonoro", "OpenDouEventPlayer3D — la valvula, creada una vez y nunca tocada", "Pool de buses de reverb — un bus por escalon de RT60"])

