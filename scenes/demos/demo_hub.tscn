[node name="Card_Keel" parent="Margin/Column/Center/Grid" instance=ExtResource("3_card")]
layout_mode = 2
demo_title = "Bajo la quilla"
thesis = "El mismo emisor suena de cuatro maneras distintas solo por geometria: directo, difractado, como cola de reverb, y opaco bajo el agua."
scene_path = "res://scenes/demos/keel/keel_demo.tscn"

[node name="Card_Monsoon" parent="Margin/Column/Center/Grid" instance=ExtResource("3_card")]
layout_mode = 2
demo_title = "El monzon"
thesis = "200 emisores contra 32 voces fisicas. El voice stealing decide cada frame, y el trueno hunde el ambiente porque la ventana HDR subio."
scene_path = "res://scenes/demos/monsoon/monsoon_demo.tscn"

[node name="Card_Cabin" parent="Margin/Column/Center/Grid" instance=ExtResource("3_card")]
layout_mode = 2
demo_title = "La cabina"
thesis = "Un solo RTPC conduce tres cosas a la vez -stems, filtro de la radio, reverb- y los estados cruzan en lugar de cortar."
scene_path = "res://scenes/demos/cabin/cabin_demo.tscn"

[node name="Card_Street" parent="Margin/Column/Center/Grid" instance=ExtResource("3_card")]
layout_mode = 2
demo_title = "Una casa canta"
thesis = "Una casa vibra, dos duermen, y la calle es el puente: la musica sale por la ventana entreabierta, y dentro de las dormidas la calle llega amortiguada."
scene_path = "res://scenes/demos/street/street_demo.tscn"

[node name="Card_Workshop" parent="Margin/Column/Center/Grid" instance=ExtResource("3_card")]
layout_mode = 2
demo_title = "El taller"
thesis = "Los objetos suenan solos: cuerpos que chocan, un mecanico que saluda, la radio como altavoz de verdad, un motor por RPM y una lona por su punto mas cercano."
scene_path = "res://scenes/demos/workshop/workshop_demo.tscn"

[node name="Card_Presa" parent="Margin/Column/Center/Grid" instance=ExtResource("3_card")]
layout_mode = 2
demo_title = "La presa"
thesis = "Un valle entero suena por geometria: nave, cristal, tunel en L, compuerta, agua, rio, camion, tormenta y vigilantes que te oyen."
scene_path = "res://scenes/demos/presa/presa_demo.tscn"

[node name="Card_Bench" parent="Margin/Column/Center/Grid" instance=ExtResource("3_card")]
layout_mode = 2
demo_title = "Banco del rig"
thesis = "Tres materiales, un jugador con oyente y un NPC sin el. Donde se valida la convencion de metadata antes de que las demos dependan de ella."
scene_path = "res://scenes/rig_bench/rig_bench.tscn"

[node name="Footer" type="Label" parent="Margin/Column"]
layout_mode = 2
