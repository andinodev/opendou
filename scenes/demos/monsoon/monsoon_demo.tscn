[node name="Hud" parent="." instance=ExtResource("8_hud")]
demo_title = "El monzon"
thesis = "200 emisores contra un presupuesto de 32 voces fisicas: 168 quedan virtuales y el voice stealing decide cuales cada frame. Cuando cae el trueno el ambiente se hunde, y no porque nadie lo programara: porque la ventana HDR subio."
controls = Array[String](["Flechas — caminar por las terrazas", "T — lanzar un trueno", "F8 — monitor de voces audibles", "F1 — mostrar u ocultar este cartel"])
exercises = Array[String](["post_event masivo — 200 instancias sobre 32 voces", "Voice stealing — por prioridad Y distancia, no solo distancia", "HDR — el trueno declara +18 dB y hunde el ambiente", "OpenDouMultiPositionEmitter3D — el canal de riego como objeto grande", "OpenDouSplineEmitter3D — la linea de arboles, con doppler y absorcion de aire", "OpenDouGranularEmitter3D — el enjambre de cigarras", "OpenDouAudibleMonitor — que voces se oyen ahora mismo", "LOD acustico — lo lejano no gasta raycasts de oclusion"])
