[node name="Hud" parent="." instance=ExtResource("11_hud")]
demo_title = "Una casa canta"
thesis = "Una casa vibra, dos duermen, y la calle es el puente. La musica SALE por la ventana entreabierta -filtrada, atenuada y viniendo de la ventana-, el coche reverbera entre las tres fachadas, y dentro de las casas dormidas el silencio no es ausencia de sonido: es la calle amortiguada por ventanas cerradas."
controls = Array[String](["Flechas — caminar", "Raton — mirar", "E — abrir o cerrar la puerta o la ventana mas cercana", "F9 — depurador acustico", "F1 — mostrar u ocultar este cartel"])
exercises = Array[String](["OpenDouRoom3D x4 — tres casas y LA CALLE como sala Outdoor", "OpenDouPortal3D x6 — puertas con hoja y ventanas, abiertas o cerradas", "Grafo de salas — la musica sale por la ventana con origen aparente en ella", "OpenDouReflector3D — el eco entre las tres fachadas y la medianera", "OpenDouAcousticGeometryBake — cada pared es geometria acustica", "OpenDouEventPlayer3D — musica, farola y motor del coche", "OpenDouSplineEmitter3D — la brisa a lo largo de la calle", "Doppler nativo — el coche pasa de un extremo al otro", "AudioRandomContainer — hojas, ladridos y chispazos con variacion", "Oclusion por raycast — paredes de verdad entre el oyente y las fuentes", "Pisadas — asfalto, hormigon, madera, piedra y cristal por metadata"])
