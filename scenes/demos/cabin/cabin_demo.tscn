[node name="Hud" parent="." instance=ExtResource("6_hud")]
demo_title = "La cabina"
thesis = "UN solo valor de RTPC -Tension- conduce TRES cosas a la vez: que stems musicales suenan, el corte del filtro de la radio, y el envio de reverb de la cabina. Y los estados CRUZAN en lugar de cortar."
controls = Array[String](["1 / 2 / 3 — rutina, alerta, emergencia", "R — cambiar de estacion de radio", "Flechas — caminar de la tarima a la rejilla", "F1 — mostrar u ocultar este cartel"])
exercises = Array[String](["OpenDouMusicPlayer — cuatro stems, un bus cada uno", "States con crossfade — la situacion cruza, no corta", "RTPC — un valor moviendo tres cosas coherentemente", "RTPCBinding sobre cutoff_hz — el filtro de la radio", "Triggers — un nombre posteado produce un stinger", "Switches — la estacion elige que linea de radio suena", "AudioSwitchContainer — el chatter, una rama por estacion", "SoundBank — locuciones precargadas desde un .bnk", "Tabla de dialogo — las mismas locuciones en dos lenguas", "OpenDouEventPlayer — la radio, NO espacial"])

