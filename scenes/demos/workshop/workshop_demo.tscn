[node name="Hud" parent="." instance=ExtResource("13_hud")]
demo_title = "El taller"
thesis = "Los objetos suenan solos: los cuerpos al chocar segun material y velocidad, el mecanico al acercarse con subtitulo y boca, la radio como altavoz de verdad, el motor por RPM y carga, la lona desde su punto mas cercano."
controls = Array[String](["Flechas — caminar", "Raton — mirar", "E — soltar la repisa", "Arriba / Abajo — RPM del motor", "Espacio — carga del motor", "F9 — depurador acustico", "F1 — mostrar u ocultar este cartel"])
exercises = Array[String](["OpenDouPhysicsImpact3D — lata, caja y llave suenan al chocar", "OpenDouDialogueEmitter3D — el mecanico saluda con subtitulo y boca", "OpenDouParameterArea3D (trigger) — el area frente al mecanico dispara el saludo", "OpenDouEventPlayer3D (BUS_CAPTURE) — la radio como altavoz del mundo", "OpenDouEventPlayer3D + BlendContainer — el motor por RPM y carga", "OpenDouMultiPositionEmitter3D (MESH) — la lona suena desde su punto mas cercano", "OpenDouRoom3D — el taller con su reverb"])

